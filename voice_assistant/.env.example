# Copy to .env and fill in. Never commit .env.
# A stage whose key is blank uses its stand-in (see README.md).

# Deepgram: speech to text, and the assistant's voice.
DEEPGRAM_API_KEY=

# SubQ: Snap, the decision model that gates and routes.
SUBQ_API_KEY=

# Meta AI (Model API): the model that writes the answer.
META_API_KEY=

# Anthropic: used for the answer instead, when META_API_KEY is blank.
ANTHROPIC_API_KEY=

# Optional settings. Remove the "#" to change one.
# DEEPGRAM_STT_MODEL=nova-3-medical     Deepgram's variant for drug and condition names
# DEEPGRAM_VOICE=aura-2-asteria-en
# ANSWER_MODEL=muse-spark-1.3           default: muse-ember-1.0 (Meta) or claude-haiku-5-5 (Anthropic)
# ROUTER_MODEL=subq-snap-1.2
# TRIGGER_PHRASE=chart check            a sentence starting with this always goes to the assistant
# TRIGGER_ONLY=1                        answer only when the phrase is said; ignore everything else
